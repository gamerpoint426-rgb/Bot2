# Minecraft server
MC_HOST=play.gamerpointmc.qzz.io
MC_PORT=25565
MC_VERSION=1.21.11

# Bot manager
BOT_COUNT=1
RECONNECT_DELAY=10000
PANEL_PORT=3000
PANEL_HOST=0.0.0.0

# Optional panel protection. Leave blank for no password.
PANEL_PASSWORD=

# Random names. Comma-separated.
BOT_NAMES=GP_AFK,GP_Player,GP_Lobby,GP_Online,GP_Survival

# Optional command sent after joining. Leave blank to disable.
JOIN_COMMAND=

# Optional login command for offline-mode/auth plugins.
# Example: /login yourpassword
LOGIN_COMMAND=
LOGIN_DELAY=2500
